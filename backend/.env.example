HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ── User Sync Cron Job ──────────────────────────────────────────────────────
# Enable/disable the cron scheduler (true by default)
CRON_ENABLED=true

# External API endpoint that returns a bearer token.
# The POST body will contain { username, password } and the response must include
# a "token" or "access_token" field.
SYNC_API_TOKEN_URL=https://your-hr-api.example.com/auth/token

# Credentials sent to the token endpoint
SYNC_API_TOKEN_USERNAME=your_api_username
SYNC_API_TOKEN_PASSWORD=your_api_password

# External API endpoint that returns the list of employees (requires bearer token).
# The response can be a JSON array or { data: [...] } / { employees: [...] }.
SYNC_API_USERS_URL=https://your-hr-api.example.com/api/employees

# Default company to assign when the API response does not include a company field.
# Must be one of: AIA | Vega
SYNC_API_COMPANY=AIA
