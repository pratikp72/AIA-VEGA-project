{
  "kind": "collectionType",
  "collectionName": "important_links",
  "info": {
    "singularName": "important-link",
    "pluralName": "important-links",
    "displayName": "Important Links"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 90,
      "required": true
    },
    "url": {
      "type": "string",
      "required": true,
      "unique": false
    },
    "active": {
      "type": "enumeration",
      "enum": ["published", "unpublished"],
      "default": "published",
      "required": true
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "link_icon": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
