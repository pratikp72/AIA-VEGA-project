{
  "kind": "collectionType",
  "collectionName": "important_links",
  "info": {
    "singularName": "important-link",
    "pluralName": "important-links",
    "displayName": "Important Links"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true,
      "unique": false
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::strapi-plugin-iconhub.iconhub",
      "options": {
        "storeIconData": true,
        "storeIconName": true
      },
      "required": true
    }
  }
}
