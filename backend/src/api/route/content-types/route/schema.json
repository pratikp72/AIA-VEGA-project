{
  "kind": "collectionType",
  "collectionName": "routes",
  "info": {
    "singularName": "route",
    "pluralName": "routes",
    "displayName": "Routes"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "route_name": {
      "type": "string",
      "required": true
    },
    "bus_number": {
      "type": "string"
    },
    "bus_stops": {
      "type": "component",
      "component": "routes.bus-route",
      "repeatable": true,
      "required": true
    },
    "unit_location": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unit-location.unit-location"
    },
    "area": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::area.area"
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    }
  }
}
