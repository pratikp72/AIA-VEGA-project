{
  "kind": "collectionType",
  "collectionName": "course_assignments",
  "info": {
    "singularName": "course-assignment",
    "pluralName": "course-assignments",
    "displayName": "Course Assignments"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "assignment_target_type": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "Individual",
        "Location",
        "Department"
      ]
    },
    "due_date": {
      "type": "date",
      "required": true
    },
    "active": {
      "type": "enumeration",
      "enum": ["published", "unpublished"],
      "default": "published",
      "required": true
    },
    "courses": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::course.course",
      "mappedBy": "course_assignments"
    },
    "departments": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::department.department",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "assignment_target_type"
            },
            "Department"
          ]
        }
      }
    },
    "individual_user": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "assignment_target_type"
            },
            "Individual"
          ]
        }
      },
      "description": "Select employees to assign"
    },
    "company": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::company.company"
    },
    "work_locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::work-location.work-location",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "assignment_target_type"
            },
            "Location"
          ]
        }
      },
      "inversedBy": "course_assignments"
    }
  }
}
