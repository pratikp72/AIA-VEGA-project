{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Courses"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "duration_hours": {
      "type": "integer",
      "required": true
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "passing_score": {
      "type": "integer",
      "required": true
    },
    "prerequisite_courses": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::course.course",
      "description": "Courses to complete before this one"
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "course_category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Mandatory",
        "Orientation",
        "Other"
      ]
    },
    "modules": {
      "type": "component",
      "component": "course.module",
      "repeatable": true,
      "required": true
    },
    "course_flow_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "course_test_feedback",
        "course_test",
        "course_feedback",
        "course_only"
      ]
    }
  }
}
