{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Courses"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "prerequisite_courses": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::course.course",
      "description": "Courses to complete before this one"
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "course_category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Mandatory",
        "Orientation",
        "Other"
      ]
    },
    "modules": {
      "type": "component",
      "component": "course.module",
      "repeatable": true,
      "required": true
    },
    "quiz": {
      "type": "component",
      "component": "quiz.quiz",
      "repeatable": true
    },
    "feedback_question": {
      "type": "component",
      "component": "feedback-form.question",
      "repeatable": true
    },
    "course_duration_min": {
      "type": "customField",
      "customField": "global::number-range",
      "options": {
        "positiveOnly": true,
        "required": true
      }
    },
    "min_passing_score": {
      "type": "customField",
      "customField": "global::number-range",
      "options": {
        "positiveOnly": true,
        "required": true
      }
    },
    "course_language": {
      "type": "customField",
      "customField": "global::multi-select-dropdown",
      "options": {
        "required": true,
        "optionsList": "English\nHindi\nGujarati"
      }
    }
  }
}
