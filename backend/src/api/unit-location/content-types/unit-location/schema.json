{
  "kind": "collectionType",
  "collectionName": "unit_locations",
  "info": {
    "singularName": "unit-location",
    "pluralName": "unit-locations",
    "displayName": "Unit Locations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "text",
      "required": true
    },
    "contact": {
      "type": "string",
      "required": true
    },
    "alternative_contact": {
      "type": "string"
    },
    "location_images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "office_location": {
      "type": "boolean",
      "required": true
    },
    "factory_location": {
      "type": "boolean",
      "required": true
    },
    "units": {
      "type": "component",
      "component": "routes.bus-route",
      "repeatable": true,
      "required": true
    },
    "note": {
      "type": "blocks"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city"
    }
  }
}
