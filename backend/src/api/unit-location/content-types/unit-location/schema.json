{
  "kind": "collectionType",
  "collectionName": "unit_locations",
  "info": {
    "singularName": "unit-location",
    "pluralName": "unit-locations",
    "displayName": "Unit Locations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "text",
      "required": true
    },
    "contact": {
      "type": "string",
      "required": true
    },
    "alternative_contact": {
      "type": "string",
      "description": "Secondary or alternate contact number"
    },
    "map_snapshot": {
      "type": "media",
      "description": "Map or location image",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "emergency_gate_images": {
      "type": "media",
      "description": "Photos of emergency gate/exit",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "is_active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "area": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::area.area"
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "is_office_location": {
      "type": "boolean",
      "required": true,
      "description": "Is this an office location?"
    },
    "is_factory_location": {
      "type": "boolean",
      "required": true,
      "description": "Is this a factory location?"
    }
  }
}
