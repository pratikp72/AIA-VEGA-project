{
  "kind": "collectionType",
  "collectionName": "unit_locations",
  "info": {
    "singularName": "unit-location",
    "pluralName": "unit-locations",
    "displayName": "Locations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "active": {
      "type": "enumeration",
      "enum": ["published", "unpublished"],
      "default": "published",
      "required": true
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "Units": {
      "type": "component",
      "component": "routes.unit",
      "repeatable": true,
      "required": true
    }
  }
}
