{
  "kind": "collectionType",
  "collectionName": "unit_locations",
  "info": {
    "singularName": "unit-location",
    "pluralName": "unit-locations",
    "displayName": "Locations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "units": {
      "type": "component",
      "component": "routes.bus-route",
      "repeatable": true,
      "required": true
    },
    "note": {
      "type": "blocks"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city"
    }
  }
}
