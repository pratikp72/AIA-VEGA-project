{
  "kind": "collectionType",
  "collectionName": "companies",
  "info": {
    "singularName": "company",
    "pluralName": "companies",
    "displayName": "Company"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "company_overview": {
      "type": "text"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "website": {
      "type": "string",
      "required": true
    },
    "company_mail": {
      "type": "email"
    },
    "address": {
      "type": "text",
      "required": true
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "company_type": {
      "type": "string",
      "required": true
    },
    "holidays": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::holiday.holiday",
      "inversedBy": "companies"
    },
    "course_assignments": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::course-assignment.course-assignment",
      "inversedBy": "companies"
    },
    "work_locations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::work-location.work-location",
      "mappedBy": "company"
    }
  }
}
