{
  "kind": "collectionType",
  "collectionName": "quiz_reattempt_requests",
  "info": {
    "singularName": "quiz-reattempt-request",
    "pluralName": "quiz-reattempt-requests",
    "displayName": "Quiz Reattempt Requests"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "request_status": {
      "type": "enumeration",
      "required": true,
      "default": "Pending",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ]
    },
    "requested_for_attempt": {
      "type": "integer",
      "required": true
    }
  }
}
