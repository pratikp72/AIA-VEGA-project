{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Events"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "start_date": {
      "type": "date",
      "required": true
    },
    "end_date": {
      "type": "date",
      "required": true
    },
    "event_location": {
      "type": "text",
      "required": true
    },
    "active": {
      "type": "enumeration",
      "enum": ["published", "unpublished"],
      "default": "published",
      "required": true
    },
    "visible_on_homepage": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "active"
            },
            "published"
          ]
        }
      },
      "required": true,
      "default": false
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "event_created_for": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "All",
        "Location"
      ]
    },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "event_created_for"
            },
            "department"
          ]
        }
      }
    },
    "event_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "time_required": {
      "type": "customField",
      "customField": "global::yes-no-toggle",
      "options": {
        "required": true
      }
    },
    "start_time": {
      "type": "time",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "time_required"
            },
            true
          ]
        }
      },
      "required": true
    },
    "end_time": {
      "type": "time",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "time_required"
            },
            true
          ]
        }
      },
      "required": true
    },
    "type_of_event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event-type.event-type",
      "inversedBy": "events"
    },
    "work_locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::work-location.work-location",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "event_created_for"
            },
            "Location"
          ]
        }
      },
      "inversedBy": "events"
    }
  }
}
