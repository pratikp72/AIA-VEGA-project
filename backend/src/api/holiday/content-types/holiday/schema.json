{
  "kind": "collectionType",
  "collectionName": "holidays",
  "info": {
    "singularName": "holiday",
    "pluralName": "holidays",
    "displayName": "Holidays"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "companies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company",
      "mappedBy": "holidays"
    }
  }
}
