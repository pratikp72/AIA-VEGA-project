{
  "kind": "collectionType",
  "collectionName": "holidays",
  "info": {
    "singularName": "holiday",
    "pluralName": "holidays",
    "displayName": "Holidays"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "active": {
      "type": "enumeration",
      "required": true,
      "default": "published",
      "enum": [
        "published",
        "unpublished"
      ]
    },
    "companies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company",
      "mappedBy": "holidays"
    },
    "work_locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::work-location.work-location",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "holiday_for"
            },
            "Individual location"
          ]
        }
      },
      "inversedBy": "holidays"
    },
    "holiday_for": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "All location",
        "Individual location"
      ]
    }
  }
}
