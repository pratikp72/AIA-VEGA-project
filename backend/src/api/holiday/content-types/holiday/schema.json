{
  "kind": "collectionType",
  "collectionName": "holidays",
  "info": {
    "singularName": "holiday",
    "pluralName": "holidays",
    "displayName": "Holidays"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "active": {
      "type": "enumeration",
      "enum": ["published", "unpublished"],
      "default": "published",
      "required": true
    },
    "companies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company",
      "mappedBy": "holidays"
    },
    "work_locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::work-location.work-location",
      "inversedBy": "holidays"
    }
  }
}
