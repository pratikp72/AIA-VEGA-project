{
  "kind": "collectionType",
  "collectionName": "holidays",
  "info": {
    "singularName": "holiday",
    "pluralName": "holidays",
    "displayName": "Holidays"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "companies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "holiday_for"
            },
            "Company"
          ]
        }
      },
      "mappedBy": "holidays"
    },
    "holiday_for": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Company",
        "Location"
      ]
    },
    "locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::unit-location.unit-location",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "holiday_for"
            },
            "Location"
          ]
        }
      },
      "inversedBy": "holidays"
    }
  }
}
