{
  "kind": "collectionType",
  "collectionName": "holidays",
  "info": {
    "singularName": "holiday",
    "pluralName": "holidays",
    "displayName": "Holidays"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "holiday_for"
            },
            "City"
          ]
        }
      }
    },
    "departments": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::department.department",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "holiday_for"
            },
            "Department"
          ]
        }
      }
    },
    "holiday_for": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "All",
        "Unit_location",
        "City",
        "Department"
      ]
    },
    "companies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company",
      "mappedBy": "holidays"
    },
    "work_location": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::work-location.work-location",
      "inversedBy": "holidays"
    }
  }
}
