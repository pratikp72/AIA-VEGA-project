{
  "kind": "collectionType",
  "collectionName": "module_video_progress",
  "info": {
    "singularName": "module-video-progress",
    "pluralName": "module-video-progresses",
    "displayName": "Module Video Progress"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "required": true
    },
    "module_index": {
      "type": "integer",
      "required": true,
      "description": "Index of the module within the course's modules component (0-based)"
    },
    "module_title": {
      "type": "string",
      "description": "Denormalized module title for display"
    },
    "video_completion_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "full_watch",
        "skipped_to_end",
        "in_progress",
        "not_started"
      ]
    },
    "time_watched_seconds": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "video_duration_seconds": {
      "type": "integer",
      "required": false
    },
    "last_updated": {
      "type": "datetime",
      "required": true
    }
  }
}
