{
  "kind": "collectionType",
  "collectionName": "news_items",
  "info": {
    "singularName": "news",
    "pluralName": "news-items",
    "displayName": "News"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "visible_on_homepage": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "active"
            },
            true
          ]
        }
      },
      "required": true,
      "default": false
    },
    "news_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::news-category.news-category"
    },
    "company": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company"
    },
    "publish_date": {
      "type": "customField",
      "customField": "global::date-future-only"
    }
  }
}
