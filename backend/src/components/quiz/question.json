{
  "collectionName": "components_quiz_questions",
  "info": {
    "displayName": "Question"
  },
  "options": {},
  "attributes": {
    "question_id": {
      "type": "string",
      "required": true
    },
    "question_text": {
      "type": "text",
      "maxLength": 500,
      "required": true
    },
    "question_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Multiple_choice",
        "Multiple_select"
      ]
    },
    "order": {
      "type": "integer"
    },
    "options": {
      "type": "component",
      "component": "quiz.options",
      "repeatable": true
    },
    "correct_answer": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "question_type"
            },
            "Multiple_choice"
          ]
        }
      },
      "required": true
    },
    "correct_multiSelect_answers": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "question_type"
            },
            "Multiple_select"
          ]
        }
      },
      "component": "quiz.multiselect-question-answer",
      "repeatable": true,
      "required": true
    }
  },
  "config": {}
}
