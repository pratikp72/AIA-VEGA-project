{
  "collectionName": "components_quiz_questions",
  "info": {
    "displayName": "Question"
  },
  "options": {},
  "attributes": {
    "question_id": {
      "type": "string",
      "required": true
    },
    "question_text": {
      "type": "text",
      "required": true
    },
    "question_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Multiple_choice",
        "Multiple_select"
      ]
    },
    "order": {
      "type": "integer"
    },
    "options": {
      "type": "component",
      "component": "quiz.options",
      "repeatable": true
    },
    "point": {
      "type": "customField",
      "customField": "global::number-range",
      "options": {
        "positiveOnly": true,
        "min": "1"
      }
    }
  },
  "config": {}
}
