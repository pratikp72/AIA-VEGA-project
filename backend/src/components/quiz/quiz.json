{
  "collectionName": "components_quiz_quizzes",
  "info": {
    "displayName": "Quiz"
  },
  "options": {},
  "attributes": {
    "quiz_id": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "language": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "English",
        "Hindi",
        "Gujarati"
      ]
    },
    "quiz_questions": {
      "type": "component",
      "component": "quiz.question",
      "repeatable": true,
      "required": true
    },
    "quiz_instruction": {
      "type": "component",
      "component": "quiz.quiz-instruction",
      "repeatable": true,
      "required": true
    },
    "max_attempt": {
      "type": "customField",
      "customField": "global::number-range"
    },
    "completion_time": {
      "type": "customField",
      "customField": "global::number-range"
    },
    "compulsory": {
      "type": "customField",
      "customField": "global::yes-no-toggle",
      "options": {
        "required": true
      }
    },
    "instruction": {
      "type": "richtext",
      "required": true
    }
  },
  "config": {}
}
