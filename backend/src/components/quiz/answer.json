{
  "collectionName": "components_quiz_answers",
  "info": {
    "displayName": "Answer"
  },
  "options": {},
  "attributes": {
    "question_id": {
      "type": "string",
      "required": true
    },
    "question": {
      "type": "string",
      "required": true
    },
    "question_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Multiple_choice",
        "Multiple_select"
      ]
    },
    "selected_answer_for_multiChoice": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "question_type"
            },
            "Multiple_choice"
          ]
        }
      },
      "required": true
    },
    "point": {
      "type": "integer"
    },
    "correct": {
      "type": "boolean"
    },
    "selected_answer_for_multiSelect": {
    "type": "json",
    "conditions": {
      "visible": {
        "==": [{ "var": "question_type" }, "Multiple_select"]
      }
    }
}
  },
  "config": {}
}
