{
  "collectionName": "components_course_offline_modules",
  "info": {
    "displayName": "Offline Module"
  },
  "options": {},
  "attributes": {
    "username": {
      "type": "string",
      "required": true
    },
    "attachment": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "score": {
      "type": "integer",
      "min": 0
    },
    "attempt": {
      "type": "integer",
      "min": 0
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    }
  },
  "config": {}
}
