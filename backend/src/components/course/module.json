{
  "collectionName": "components_course_modules",
  "info": {
    "displayName": "Module"
  },
  "options": {},
  "attributes": {
    "module_id": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "language": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "English",
        "Hindi",
        "Gujarati"
      ]
    },
    "title": {
      "type": "string",
      "required": true
    },
    "module_content_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Video",
        "Pdf",
        "Text"
      ]
    },
    "video_file": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "module_content_type"
            },
            "Video"
          ]
        }
      },
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "videos"
      ]
    },
    "pdf_file": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "module_content_type"
            },
            "Pdf"
          ]
        }
      },
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "mark_as_read": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "module_duration_min": {
      "type": "customField",
      "customField": "global::number-range",
      "options": {
        "required": true,
        "positiveOnly": true
      }
    },
    "text_content": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "module_content_type"
            },
            "Text"
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "required": true
    },
    "video_description": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "module_content_type"
            },
            "Video"
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "required": true,
      "default": ""
    }
  },
  "config": {}
}
