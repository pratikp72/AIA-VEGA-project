{
  "collectionName": "components_course_modules",
  "info": {
    "displayName": "Module"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "module_content_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Video",
        "Pdf",
        "Text"
      ]
    },
    "video_file": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "module_content_type"
            },
            "Video"
          ]
        }
      },
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos",
        "files",
        "audios"
      ]
    },
    "pdf_file": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "module_content_type"
            },
            "Pdf"
          ]
        }
      },
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos",
        "files",
        "audios"
      ]
    },
    "text_content": {
      "type": "blocks",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "module_content_type"
            },
            "Text"
          ]
        }
      }
    },
    "duration_minutes": {
      "type": "integer",
      "required": true
    },
    "mark_as_read": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  },
  "config": {}
}
